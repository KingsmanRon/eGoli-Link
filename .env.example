# Database
DATABASE_URL=postgresql://citypower:password@localhost:5432/citypower_dispatch?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Geocoding
GOOGLE_GEOCODING_API_KEY=your-google-api-key
NOMINATIM_USER_AGENT=eGoliLink/1.0

# File Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# S3 (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=af-south-1
S3_BUCKET=egoli-link-dispatch

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Client (Vite)
VITE_API_URL=http://localhost:3000/api
VITE_MAP_CENTER_LAT=-26.2041
VITE_MAP_CENTER_LNG=28.0473
